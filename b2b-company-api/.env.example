# HTTP server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Cache
CACHE_TTL_MS=86400000
CACHE_MAX_ENTRIES=5000

# Upstream timeouts / retries
UPSTREAM_TIMEOUT_MS=10000
UPSTREAM_RETRIES=2

# VIES (EU VAT validation)
VIES_BASE_URL=https://ec.europa.eu/taxation_customs/vies/rest-api

# Polish GUS BIR1.1
# Test key `abcde12345abcde12345` only works against the *test* endpoint below.
# For production, register at https://api.stat.gov.pl and swap both values.
GUS_BASE_URL=https://wyszukiwarkaregontest.stat.gov.pl/wsBIR/UslugaBIRzewnPubl.svc
GUS_USER_KEY=abcde12345abcde12345
