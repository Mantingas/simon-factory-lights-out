# HTTP server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Cache
CACHE_TTL_MS=86400000
CACHE_MAX_ENTRIES=5000

# Upstream timeouts / retries
UPSTREAM_TIMEOUT_MS=10000
UPSTREAM_RETRIES=2

# VIES (EU VAT validation)
VIES_BASE_URL=https://ec.europa.eu/taxation_customs/vies/rest-api

# Polish GUS BIR1.1
# Test key `abcde12345abcde12345` only works against the *test* endpoint below.
# For production, register at https://api.stat.gov.pl and swap both values.
GUS_BASE_URL=https://wyszukiwarkaregontest.stat.gov.pl/wsBIR/UslugaBIRzewnPubl.svc
GUS_USER_KEY=abcde12345abcde12345

# Polish VAT white list ("Biała Lista podatników VAT")
# Free Ministry of Finance API — no key required.
WL_BASE_URL=https://wl-api.mf.gov.pl
WL_ENABLED=true

# Authentication & quotas
# `key:tier` pairs, or a JSON array: [{"key":"...","tier":"pro","label":"Acme"}]
# Tiers: starter | pro | unlimited. No key = the `anonymous` tier.
API_KEYS=dev-starter-key:starter,dev-pro-key:pro,dev-unlimited-key:unlimited
# Only enable behind a proxy you control — it makes anonymous quota spoofable.
TRUST_PROXY=false
ANONYMOUS_DAILY_LIMIT=20
STARTER_MONTHLY_LIMIT=1000
PRO_MONTHLY_LIMIT=50000
